{
  "manifest_version": 3,
  "name": "Artist Vault Connector",
  "version": "2.0.0",
  "description": "Import your music catalog from DistroKid and SoundOn into Artist Vault.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://distrokid.com/*",
    "https://sound.on.fm/*",
    "https://soundon.fm/*",
    "https://aiartistvault.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://distrokid.com/*",
        "https://sound.on.fm/*",
        "https://soundon.fm/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
