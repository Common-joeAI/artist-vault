enum MetadataEnhancementStatus {
  queued
  processing
  completed
  failed
}

enum LyricsSource {
  provider
  transcription
  manual
}

model MetadataEnhancementJob {
  id                    String   @id @default(cuid())
  trackId               String
  track                 Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  status                MetadataEnhancementStatus @default(queued)
  startedAt             DateTime?
  completedAt           DateTime?
  failedAt              DateTime?

  sourceFileName        String?
  sourceMimeType        String?
  sourceByteSize        Int?

  transcriptionProvider String?
  aiModel               String?

  requestJson           Json?
  resultJson            Json?
  errorJson             Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([trackId, createdAt])
  @@index([status, createdAt])
}

