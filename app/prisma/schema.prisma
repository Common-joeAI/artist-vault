generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// NOTE: SQLite does not support native enums.
// All enum-like fields use String with documented allowed values.
// Switch provider to "postgresql" for production Supabase deployment.
// ─────────────────────────────────────────────

// UserRole: "artist" | "radio_station" | "admin"
// ReleaseType: "SINGLE" | "EP" | "ALBUM"
// RegistrationStatus: "NOT_STARTED" | "IN_PROGRESS" | "SUBMITTED" | "APPROVED"
// ProOrg: "ASCAP" | "BMI"
// UploadCategory: "press" | "covers" | "masters" | "previews" | "misc"
// MetadataEnhancementStatus: "queued" | "processing" | "completed" | "failed"
// LyricsSource: "provider" | "transcription" | "manual"
// ImportProvider: "distrokid" | "soundon"
// ImportSessionStatus: "pending" | "running" | "completed" | "failed"
// RadioNotificationStatus: "pending" | "sent" | "failed"

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  passwordHash          String
  name                  String?
  role                  String          @default("artist")
  emailVerified         Boolean         @default(false)
  emailVerifyToken      String?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  proOrg                String?         // "ASCAP" | "BMI"
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  uploads               Upload[]
  artistProfiles        ArtistProfile[]
  importSessions        ImportSession[]
  radioStation          RadioStation?
  proRegistrations      ProRegistration[]

  @@index([email])
  @@index([role])
}

model RadioStation {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationName      String
  contactName      String?
  contactEmail     String?
  website          String?
  city             String?
  state            String?
  country          String   @default("US")
  genrePreferences String?
  notifyOnRelease  Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  notifications    RadioNotification[]

  @@index([notifyOnRelease])
}

model RadioNotification {
  id             String   @id @default(cuid())
  radioStationId String
  radioStation   RadioStation @relation(fields: [radioStationId], references: [id], onDelete: Cascade)
  releaseId      String
  release        Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  status         String   @default("pending") // "pending" | "sent" | "failed"
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@unique([radioStationId, releaseId])
  @@index([status, createdAt])
}

model ProRegistration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId     String?
  track       Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)
  org         String   // "ASCAP" | "BMI"
  status      String   @default("NOT_STARTED")
  workId      String?
  submittedAt DateTime?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, org])
  @@index([trackId])
}

model ArtistProfile {
  id          String       @id @default(cuid())
  ownerUserId String?
  name        String
  bio         String?
  photoUrl    String?
  genres      String?
  slug        String?      @unique
  isPublic    Boolean      @default(false)
  location    String?
  website     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ownerUser   User?        @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  links       ArtistLink[]
  releases    Release[]
  pressKits   PressKit[]

  @@index([ownerUserId, createdAt])
}

model ArtistLink {
  id        String        @id @default(cuid())
  artistId  String
  platform  String
  label     String?
  url       String
  createdAt DateTime      @default(now())
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, platform])
}

model Release {
  id               String    @id @default(cuid())
  artistId         String
  title            String
  releaseType      String    @default("SINGLE")
  distributor      String?
  releaseDate      DateTime?
  coverArtUrl      String?
  spotifyUrl       String?
  appleMusicUrl    String?
  youtubeMusicUrl  String?
  notes            String?

  masterUploaded    Boolean  @default(false)
  coverArtUploaded  Boolean  @default(false)
  isReleaseReady    Boolean  @default(false)

  discoveredOnYoutube Boolean @default(false)
  youtubeUrl          String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  artist           ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks           Track[]
  radioNotifications RadioNotification[]

  @@index([artistId, releaseDate])
  @@index([isReleaseReady])
}

model Track {
  id              String   @id @default(cuid())
  releaseId       String
  title           String
  trackNumber     Int?
  isrc            String?
  lyrics          String?
  masterFileUrl   String?
  audioPreviewUrl String?
  durationSeconds Int?
  bpm             Int?
  explicit        Boolean  @default(false)

  proStatus  String   @default("NOT_STARTED")
  proWorkId  String?
  proNotes   String?

  ascapStatus String   @default("NOT_STARTED")
  bmiStatus   String   @default("NOT_STARTED")
  ascapWorkId String?
  bmiWorkId   String?
  ascapNotes  String?
  bmiNotes    String?

  writers    String?
  producers  String?
  splitNotes String?

  enhancerStatus         String    @default("queued")
  enhancedAt             DateTime?
  lastEnhancementError   String?

  recognizedTitle       String?
  recognizedArtist      String?
  recognizedAlbum       String?
  recognizedLabel       String?
  recognizedReleaseDate DateTime?

  upc                    String?
  distributorName        String?
  distributionKnown      Boolean?
  distributionStatusText String?

  streamingLinksJson        String? // JSON
  providerRawJson           String? // JSON
  aiEnhancedJson            String? // JSON
  lyricsText                String?
  lyricsStructuredJson      String? // JSON
  lyricsLrc                 String?
  lyricsSrt                 String?
  lyricsSource              String?
  lyricsConfidence          Float?
  humanAuthorshipFlagsJson  String? // JSON
  suggestedWriterSplitsJson String? // JSON
  pressKitSuggestionsJson   String? // JSON

  metadataJobs     MetadataEnhancementJob[]
  proRegistrations ProRegistration[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  release          Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, trackNumber])
  @@index([isrc])
}

model ImportSession {
  id                 String    @id @default(cuid())
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider           String    // "distrokid" | "soundon"
  sessionToken       String    @unique @default(cuid())
  status             String    @default("pending")
  releaseCount       Int       @default(0)
  importedReleaseIds String?   // JSON array
  rawPayloadJson     String?   // JSON
  errors             String?   // JSON array
  expiresAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([sessionToken])
  @@index([status, createdAt])
  @@index([provider, status])
}

model Upload {
  id               String   @id @default(cuid())
  filename         String
  originalName     String
  contentType      String
  size             Int
  category         String   @default("misc")
  relativePath     String
  publicUrl        String
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?
  uploadedByUser   User?    @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([category, uploadedAt])
  @@index([uploadedByUserId, uploadedAt])
}

model PressKit {
  id               String        @id @default(cuid())
  artistId         String
  title            String
  slug             String        @unique
  isPublic         Boolean       @default(true)
  shortBio         String?
  longBio          String?
  heroImageUrl     String?
  websiteUrl       String?
  contactEmail     String?
  featuredTrackIds String?       // JSON array
  radioFormat      Boolean       @default(false)
  generatedAt      DateTime      @default(now())
  artist           ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

model MetadataEnhancementJob {
  id                    String    @id @default(cuid())
  trackId               String
  track                 Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  status                String    @default("queued")
  startedAt             DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  sourceFileName        String?
  sourceMimeType        String?
  sourceByteSize        Int?
  transcriptionProvider String?
  aiModel               String?
  requestJson           String?   // JSON
  resultJson            String?   // JSON
  errorJson             String?   // JSON
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([trackId, createdAt])
  @@index([status, createdAt])
}

model OnboardingDiscoveryJob {
  id              String    @id @default(cuid())
  ownerUserId     String?
  artistProfileId String?
  status          String    @default("queued")
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  requestedUrlsJson String? // JSON
  snapshotJson      String? // JSON
  resultJson        String? // JSON
  errorJson         String? // JSON
  aiModel           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerUserId, createdAt])
  @@index([artistProfileId, createdAt])
  @@index([status, createdAt])
}

model ExternalDiscoveryJob {
  id              String    @id @default(cuid())
  ownerUserId     String?
  artistProfileId String?
  artistName      String
  status          String    @default("queued")
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  youtubeSearched   Boolean @default(false)
  spotifySearched   Boolean @default(false)
  discoveredJson    String? // JSON
  aiSummaryJson     String? // JSON
  errorJson         String? // JSON
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
}

model Prompt {
  id            String   @id @default(cuid())
  artistId      String
  trackId       String?
  releaseId     String?

  // The actual prompt text
  promptText    String

  // AI tool used (suno, udio, aimusicgen, musicfy, etc.)
  aiTool        String   @default("suno")

  // Version / model used inside the tool
  aiModel       String?

  // Style tags the user manually adds
  styleTags     String?  // JSON array stored as string

  // Groq-enhanced metadata
  enhancedTitle       String?
  enhancedGenre       String?
  enhancedMood        String?
  enhancedDescription String?
  enhancedTags        String?  // JSON array
  groqEnhancedAt      DateTime?

  // Outcome
  resultRating  Int?     // 1-5 stars
  resultNotes   String?
  isPublic      Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([artistId, createdAt])
  @@index([aiTool, createdAt])
}

model StyleDna {
  id            String   @id @default(cuid())
  artistId      String   @unique
  topGenres     String?  // JSON array
  topMoods      String?  // JSON array
  topThemes     String?  // JSON array
  topTools      String?  // JSON array
  bpmRange      String?  // JSON {min, max, avg}
  energyProfile String?  // low|medium|high
  soundsLike    String?  // JSON array of similar artists
  summary       String?  // 2-3 sentence Groq-generated bio
  tags          String?  // JSON array
  lastComputedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([artistId])
}

model CollabPost {
  id            String   @id @default(cuid())
  artistId      String
  title         String
  description   String
  type          String   @default("SEEKING") // SEEKING | OFFERING
  role          String   // vocalist, beatmaker, mixing engineer, etc.
  genres        String?  // JSON array
  moods         String?  // JSON array
  tools         String?  // JSON array
  contactMethod String?  // email, discord, instagram, etc.
  contactValue  String?
  isOpen        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([artistId, createdAt])
  @@index([isOpen, createdAt])
  @@index([type, createdAt])
}
